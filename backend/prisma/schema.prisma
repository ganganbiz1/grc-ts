generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// サンプルモデル（後で実際のドメインモデルに置き換え）
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
